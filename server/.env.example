# Copy this file to .env and fill in real values before running.

# A long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Generate both with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Your timezone, so the 10 AM / 2 PM reminders fire at the right local time.
# Example for India: Asia/Kolkata
TZ=Asia/Kolkata

PORT=3000
